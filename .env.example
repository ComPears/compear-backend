# Server
PORT=4000

# Comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8888,https://compears.shop

# Required to trigger POST /scrape/:store and protect GET /scrape/status + GET /health/metrics
# (send as x-api-key header). ADMIN_API_KEY and SCRAPE_API_KEY are both accepted when set.
SCRAPE_API_KEY=change-me-to-a-long-random-string
ADMIN_API_KEY=

# HMAC secret for receipt session tokens (required in production)
RECEIPT_AUTH_SECRET=

# Path to compears-data-wrangling (defaults to ../compears-data-wrangling)
# WRANGLING_PATH=/path/to/compears-data-wrangling

# Required in production for /api/v1 (503 when unset). Optional in development.
PUBLIC_API_KEY=change-me-public-api-key

# SEED_MAX_PRODUCTS=0

# Optional: OpenAI for normalization, promo interpretation, and receipt OCR
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.5
# OPENAI_VISION_MODEL=gpt-5.5

# Approximate monthly OpenAI spend cap in USD (default 10). Estimates use model token pricing.
AI_MONTHLY_BUDGET_USD=10
# Optional pricing overrides (USD per 1M tokens); defaults are approximate for gpt-4o / gpt-5.5
# AI_PRICE_INPUT_PER_1M=
# AI_PRICE_OUTPUT_PER_1M=

# AI rate limits (OpenAI calls only; cache hits are free)
# AI_MAX_VISION_PER_USER_HOUR=5
# AI_MAX_VISION_PER_USER_DAY=20
# AI_MAX_VISION_PER_IP_HOUR=10
# AI_MAX_TEXT_PER_USER_HOUR=40
# AI_MAX_TEXT_PER_RECEIPT=15
# AI_MAX_GLOBAL_HOUR=120
# AI_MAX_GLOBAL_DAY=600
# AI_MIN_INTERVAL_MS=500
# Use gpt-5-codex only for coding-style tasks (not ideal for receipts):
# OPENAI_MODEL=gpt-5-codex
