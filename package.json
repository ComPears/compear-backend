{
  "name": "compears-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "rm -rf dist && tsc && cp -r src/data dist/data && mkdir -p dist/data/receipts dist/data/lists",
    "test": "npm run build && node --import tsx --test tests/*.test.ts && node --test test/*.test.js",
    "test:memory": "node test/benchmarks/memory-budget.js",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "scrape:ah": "tsx src/scrapers/run-albert-heijn.ts",
    "seed": "tsx src/scripts/seedFromWrangling.ts",
    "import-stores": "tsx src/scripts/importStoreLocationsFromOsm.ts",
    "eval:receipt-matching": "tsx src/scripts/evalReceiptMatching.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "heic-convert": "^2.1.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "openai": "^7.18.0",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
